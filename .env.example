# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# AI Text Enhancement (Optional)
# Leave blank to use built-in deterministic rule-based NLP rewriting
GEMINI_API_KEY=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=5
