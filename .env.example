# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-resume-forge-ai-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite if not provided)
# For SQLite (default):
DATABASE_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For MySQL (optional):
# DATABASE_ENGINE=django.db.backends.mysql
